# Template for a separate setup. The group already has a configured shared .env.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/librarysys
JWT_SECRET=replace-this-with-your-own-random-secret
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional: use process-specific resolvers if the local DNS rejects Atlas SRV lookups.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
# Optional frontend override: VITE_API_URL=http://localhost:5000/api
